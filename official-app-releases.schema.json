{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/readysteadyscience/Rabbisir-Releases/main/official-app-releases.schema.json",
  "title": "Rabbisir Official App Releases",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "channel", "updatedAt", "authority", "latest", "releases"],
  "properties": {
    "$schema": { "const": "./official-app-releases.schema.json" },
    "schemaVersion": { "const": 2 },
    "channel": { "const": "production" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "appcastURL", "stableDownloadURL"],
      "properties": {
        "repository": { "const": "readysteadyscience/Rabbisir-Releases" },
        "appcastURL": { "const": "https://raw.githubusercontent.com/readysteadyscience/Rabbisir-Releases/main/appcast.xml" },
        "stableDownloadURL": { "const": "https://github.com/readysteadyscience/Rabbisir-Releases/releases/latest/download/Rabbisir.dmg" }
      }
    },
    "latest": { "$ref": "#/$defs/identity" },
    "releases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/release" }
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "build", "tag"],
      "properties": {
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "build": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "tag": { "type": "string", "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" }
      }
    },
    "localizedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zh", "en"],
      "properties": {
        "zh": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "size", "sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "build", "tag", "publishedOn", "selectedTypes", "categories", "releaseURL", "assets"],
      "properties": {
        "version": { "$ref": "#/$defs/identity/properties/version" },
        "build": { "$ref": "#/$defs/identity/properties/build" },
        "tag": { "$ref": "#/$defs/identity/properties/tag" },
        "publishedOn": { "type": "string", "format": "date" },
        "selectedTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["feature", "optimization", "fix"] }
        },
        "categories": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "feature": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/localizedItem" } },
            "optimization": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/localizedItem" } },
            "fix": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/localizedItem" } }
          }
        },
        "releaseURL": { "type": "string", "format": "uri", "pattern": "^https://github.com/readysteadyscience/Rabbisir-Releases/releases/tag/v" },
        "assets": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/artifact" } }
      }
    }
  }
}
